# =============================================================================
# VENOMFLOW ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and update with your actual values
# DO NOT commit .env to version control

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
APP_NAME=VenomFlow
APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=INFO

# =============================================================================
# POSTGRESQL DATABASE
# =============================================================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=venomflow
POSTGRES_USER=venomflow_user
POSTGRES_PASSWORD=changeme_postgres_password
POSTGRES_SCHEMA=public

# Connection pool settings
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=10
POSTGRES_POOL_TIMEOUT=30

# =============================================================================
# REDIS CACHE
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=changeme_redis_password
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5

# =============================================================================
# ELASTICSEARCH
# =============================================================================
ELASTIC_HOST=elasticsearch
ELASTIC_PORT=9200
ELASTIC_SCHEME=http
ELASTIC_USER=elastic
ELASTIC_PASSWORD=changeme_elastic_password
ELASTIC_INDEX_PREFIX=venomflow

# =============================================================================
# DAGSTER ORCHESTRATION
# =============================================================================
DAGSTER_HOME=/opt/dagster/dagster_home
DAGSTER_POSTGRES_HOST=postgres
DAGSTER_POSTGRES_PORT=5432
DAGSTER_POSTGRES_DB=dagster
DAGSTER_POSTGRES_USER=dagster_user
DAGSTER_POSTGRES_PASSWORD=changeme_dagster_password

# =============================================================================
# FASTAPI GRAPHQL API
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=true
API_SECRET_KEY=changeme_api_secret_key_min_32_chars_long
API_ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Settings (comma-separated list of allowed origins)
API_CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000

# =============================================================================
# MONITORING - PROMETHEUS
# =============================================================================
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION_TIME=15d

# =============================================================================
# MONITORING - GRAFANA
# =============================================================================
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme_grafana_password

# =============================================================================
# EXTERNAL APIS
# =============================================================================
# NCBI API settings
NCBI_API_KEY=your_ncbi_api_key_here
NCBI_EMAIL=your_email@example.com

# UniProt API
UNIPROT_API_BASE_URL=https://rest.uniprot.org

# PubChem API
PUBCHEM_API_BASE_URL=https://pubchem.ncbi.nlm.nih.gov/rest/pug

# =============================================================================
# BLAST CONFIGURATION
# =============================================================================
BLAST_DB_PATH=/data/blast/db
BLAST_THREADS=4
BLAST_MAX_TARGET_SEQS=100

# =============================================================================
# DATA PROCESSING
# =============================================================================
BATCH_SIZE=100
MAX_WORKERS=4
ENRICHMENT_TIMEOUT_SECONDS=300

# =============================================================================
# LOGGING
# =============================================================================
LOG_FORMAT=json
LOG_FILE_PATH=/var/log/venomflow
LOG_ROTATION=1d
LOG_RETENTION=30d
